# Copy to .env (never commit .env). Leave the key blank: the local agent works offline.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
TIDEWAY_HOST=127.0.0.1
TIDEWAY_PORT=8787
# Optional cross-platform local inference. Leave blank to use the default path.
# Configure only locally installed models; do not select a cloud model alias.
TIDEWAY_LOCAL_MODEL_URL=
TIDEWAY_LOCAL_TEXT_MODEL=
TIDEWAY_LOCAL_VISION_MODEL=
