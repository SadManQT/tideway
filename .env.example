# Copy to .env (never commit .env). Leave the key blank: the local agent works offline.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
TIDEWAY_HOST=127.0.0.1
TIDEWAY_PORT=8787
# Optional cross-platform local inference. Leave blank to use the default path.
# Configure only locally installed models; do not select a cloud model alias.
TIDEWAY_LOCAL_MODEL_URL=
TIDEWAY_LOCAL_TEXT_MODEL=
TIDEWAY_LOCAL_VISION_MODEL=
# Set to 1 only when your trusted local server supports JSON Schema output.
# This constrains plan shape; all normal tool/approval checks still apply.
TIDEWAY_LOCAL_STRUCTURED_PLANS=0
# Optional additional Inbox warning classification by the configured local model.
# Every draft still needs human review; model labels never grant permissions.
TIDEWAY_SEMANTIC_SCREENING=0
# Optional decision support workspace. Set to 0 to hide and disable its routes/tools.
TIDEWAY_DECISION_LAB=1
