    {"id":"H10","split":"held_out","condition":"A late seasonal expense needs an early receipt from beyond the horizon","features":["seasonality","receivable_beyond_horizon","early_payment"],"currency":"CAD","opening_cash":"10000","reserve_floor":"2000","transactions":[{"id":"T1","description":"Seasonal inventory insurance","category":"Insurance","type":"expense","amount":"15000","date":"2026-10-28"}],"invoices":[{"id":"I1","customer":"Winter Store","amount":"18000","due_date":"2026-10-05","expected_collection_date":"2026-11-08"}],"customer_profiles":{"Winter Store":{"min_discount_bps":100,"max_acceleration_days":30}},"expected":{"class":"feasible_rescue","reason":"A permitted early-payment offer can draw an existing receivable into the horizon; it must not create new money."}},
