  "defaults": {"opening_date": "2026-10-01", "target_date": "2026-10-20", "lookahead_days": 14, "action_limit": "50000", "daily_cap": "100000", "dual_approval_threshold": "7000", "max_deferral_days": 14, "max_discount_bps": 300},
  "scenarios": [
    {"id":"D01","split":"development","condition":"Cash surplus with ordinary operating expenses","features":["no_gap","USD"],"currency":"USD","opening_cash":"50000","reserve_floor":"5000","bills":[{"id":"B1","payee":"Harbor Cleaning","amount":"3000","due_date":"2026-10-08","reschedule_allowed":false}],"expected":{"class":"no_action_needed","reason":"Opening cash covers every scheduled obligation and the reserve."}},
    {"id":"D02","split":"development","condition":"A flexible supplier can bridge a dated receivable mismatch","features":["receivable_timing","supplier_terms","BDT"],"currency":"BDT","opening_cash":"5000","reserve_floor":"2000","bills":[{"id":"B1","payee":"Jute Materials","amount":"12000","due_date":"2026-10-05","reschedule_allowed":true}],"invoices":[{"id":"I1","customer":"Delta Retail","amount":"16000","due_date":"2026-10-01","expected_collection_date":"2026-10-10"}],"supplier_profiles":{"Jute Materials":{"style":"flexible"}},"expected":{"class":"feasible_rescue","reason":"A seven-day deferral bridges the gap until the confirmed expected receipt."}},
    {"id":"D03","split":"development","condition":"Early collection protects an imminent payroll obligation","features":["payroll","early_payment","CNY"],"currency":"CNY","opening_cash":"5000","reserve_floor":"2000","bills":[{"id":"B1","payee":"Production Staff","description":"Monthly payroll","priority":"payroll","amount":"10000","due_date":"2026-10-10","reschedule_allowed":false}],"invoices":[{"id":"I1","customer":"Shenzhen Workshop","amount":"15000","due_date":"2026-10-01","expected_collection_date":"2026-10-20"}],"customer_profiles":{"Shenzhen Workshop":{"min_discount_bps":100}},"expected":{"class":"feasible_rescue","reason":"The receivable can be collected before payroll for an allowed discount; payroll itself must never move."}},
