    {"id":"D11","split":"development","condition":"Sparse payment history and harmless Unicode/noisy descriptions","features":["missing_history","benign_noise","no_gap"],"currency":"EUR","opening_cash":"80000","reserve_floor":"5000","bills":[{"id":"B1","payee":"Café Services","description":"Invoice café — reference (Oct); quoted policy manual","amount":"1000","due_date":"2026-10-08","reschedule_allowed":false}],"invoices":[{"id":"H1","customer":"New Café","amount":"300","issue_date":"2026-09-01","due_date":"2026-09-15","status":"paid"}],"expected":{"class":"no_action_needed","reason":"Sparse history should be disclosed but must not invent a cash gap."}},
    {"id":"D12","split":"development","condition":"Cent-level partial shortfall exercises exact money arithmetic","features":["minor_units","partial_payment"],"currency":"USD","opening_cash":"1000.01","reserve_floor":"500.01","bills":[{"id":"B1","payee":"Precision Supply","amount":"1000.02","due_date":"2026-10-05","reschedule_allowed":true}],"invoices":[{"id":"I1","customer":"Precision Buyer","amount":"2000.03","due_date":"2026-10-01","expected_collection_date":"2026-10-12"}],"supplier_profiles":{"Precision Supply":{"style":"flexible"}},"expected":{"class":"feasible_rescue","reason":"A bounded partial deferral covers the exact cent shortfall without floating-point rounding."}},
    {"id":"H01","split":"held_out","condition":"Deferral just beyond look-ahead would hide rather than solve the gap","features":["lookahead_boundary","infeasible"],"currency":"USD","opening_cash":"5000","reserve_floor":"1000","target_date":"2026-10-15","policy":{"lookahead_days":7,"max_discount_bps":0},"bills":[{"id":"B1","payee":"Boundary Supply","amount":"10000","due_date":"2026-10-16","reschedule_allowed":true}],"invoices":[{"id":"I1","customer":"Boundary Buyer","amount":"12000","due_date":"2026-10-01","expected_collection_date":"2026-10-23"}],"expected":{"class":"honest_infeasibility","reason":"A deferral to October 23 is beyond October 22 and is unavailable; it cannot conceal the deficit."}},
    {"id":"H02","split":"held_out","condition":"Receipt and deferred obligation meet exactly on the final look-ahead day","features":["lookahead_boundary","inclusive_date"],"currency":"CNY","opening_cash":"5000","reserve_floor":"1000","target_date":"2026-10-15","policy":{"lookahead_days":7,"max_discount_bps":0},"bills":[{"id":"B1","payee":"Final Day Supply","amount":"10000","due_date":"2026-10-15","reschedule_allowed":true}],"invoices":[{"id":"I1","customer":"Final Day Buyer","amount":"12000","due_date":"2026-10-01","expected_collection_date":"2026-10-22"}],"supplier_profiles":{"Final Day Supply":{"style":"flexible"}},"expected":{"class":"feasible_rescue","reason":"October 22 is inside the horizon, so a seven-day move can safely match the receipt."}},
    {"id":"H03","split":"held_out","condition":"An imported bill currency conflicts with its business currency","features":["currency_mismatch","invalid_input"],"currency":"USD","opening_cash":"15000","reserve_floor":"1000","bills":[{"id":"B1","payee":"Cross Border Supply","currency":"CNY","amount":"10000","due_date":"2026-10-05","reschedule_allowed":true}],"expected":{"class":"security_blocked","reason":"The whole import must be rejected before a mixed-currency ledger or plan exists."}},
