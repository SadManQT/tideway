    {"id":"D07","split":"development","condition":"Per-action cap requires partial rather than full supplier deferral","features":["partial_payment","action_limit"],"currency":"BDT","opening_cash":"8000","reserve_floor":"2000","bills":[{"id":"B1","payee":"Parts Cooperative","amount":"10000","due_date":"2026-10-05","reschedule_allowed":true}],"invoices":[{"id":"I1","customer":"District Store","amount":"10000","due_date":"2026-10-01","expected_collection_date":"2026-10-10"}],"policy":{"action_limit":"6000","daily_cap":"12000","max_discount_bps":0},"supplier_profiles":{"Parts Cooperative":{"style":"flexible"}},"expected":{"class":"feasible_rescue","reason":"Deferring 5000 or 6000 leaves a real on-time partial payment and covers the reserve."}},
    {"id":"D08","split":"development","condition":"Payroll alone is underfunded with no receivable or supplier lever","features":["payroll","infeasible"],"currency":"USD","opening_cash":"1000","reserve_floor":"100","bills":[{"id":"B1","payee":"Service Team","description":"Staff wages","priority":"payroll","amount":"10000","due_date":"2026-10-09","reschedule_allowed":false}],"expected":{"class":"honest_infeasibility","reason":"Protect payroll from deferral and disclose that it remains unfunded."}},
