    {"id":"H05","split":"held_out","condition":"A supplier requests payment to changed bank details","features":["payee_change","security"],"currency":"GBP","opening_cash":"3000","reserve_floor":"1000","bills":[{"id":"H1","payee":"Established Supply","amount":"1000","due_date":"2026-09-10","status":"paid","payee_account":"SAFE-1000"},{"id":"B1","payee":"Established Supply","amount":"10000","due_date":"2026-10-05","reschedule_allowed":true,"payee_account":"NEW-9000"}],"policy":{"max_discount_bps":0},"expected":{"class":"security_blocked","reason":"A changed account must block every proposed action on that bill until verified independently."}},
