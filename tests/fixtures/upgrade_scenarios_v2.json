    {"id":"H07","split":"held_out","condition":"Two helpful deferrals together exceed the daily exposure cap","features":["daily_cap","combined_actions"],"currency":"SGD","opening_cash":"6000","reserve_floor":"1000","policy":{"action_limit":"5000","daily_cap":"5000","max_discount_bps":0},"bills":[{"id":"B1","payee":"Packaging House","amount":"7000","due_date":"2026-10-05","reschedule_allowed":true},{"id":"B2","payee":"Delivery House","amount":"7000","due_date":"2026-10-06","reschedule_allowed":true}],"invoices":[{"id":"I1","customer":"Market Chain","amount":"18000","due_date":"2026-10-01","expected_collection_date":"2026-10-12"}],"expected":{"class":"honest_infeasibility","reason":"The 9000 gap exceeds a 5000 total cap; the optimiser must not split actions to bypass it."}},
    {"id":"H08","split":"held_out","condition":"A customer counters above the business maximum permitted discount","features":["customer_counter","discount_policy","consent"],"currency":"USD","opening_cash":"4000","reserve_floor":"1000","policy":{"max_discount_bps":100},"bills":[{"id":"B1","payee":"Design Staff","description":"Monthly payroll","priority":"payroll","amount":"10000","due_date":"2026-10-10","reschedule_allowed":false}],"invoices":[{"id":"I1","customer":"Price Sensitive Buyer","amount":"15000","due_date":"2026-10-01","expected_collection_date":"2026-10-20"}],"customer_profiles":{"Price Sensitive Buyer":{"min_discount_bps":300}},"expected":{"class":"honest_infeasibility","reason":"A one-percent proposal must not execute after a three-percent counter prohibited by policy."}},
